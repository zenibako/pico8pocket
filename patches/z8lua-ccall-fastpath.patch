Call light C functions from OP_CALL without luaD_precall.

PICO-8 carts call API functions (spr, pal, flr, peek, ...) thousands of
times per frame; each went through luaD_precall's type switch and large
prologue and then luaD_poscall.  luaD_callcfast does the same work for a
light C function when no call, return or line hook is set; other calls
keep luaD_precall.  Yields and errors still leave by longjmp.

diff --git a/ldo.c b/ldo.c
--- a/ldo.c
+++ b/ldo.c
@@ -359,6 +359,38 @@
 }
 
 
+/*
+** Pico8Pocket: call a light C function from OP_CALL when no call, return
+** or line hooks are set -- the C half of luaD_precall plus a hook-free
+** luaD_poscall, without the type switch.  PICO-8 carts make thousands of
+** such calls (spr, pal, flr, ...) per frame.  Yields and errors leave by
+** longjmp exactly as through luaD_precall.
+*/
+void luaD_callcfast (lua_State *L, StkId func, int nresults) {
+  lua_CFunction f = fvalue(func);
+  ptrdiff_t funcr = savestack(L, func);
+  CallInfo *ci;
+  StkId res, first;
+  int n, i;
+  luaD_checkstack(L, LUA_MINSTACK);  /* ensure minimum stack size */
+  ci = next_ci(L);  /* now 'enter' new function */
+  ci->nresults = nresults;
+  ci->func = restorestack(L, funcr);
+  ci->top = L->top + LUA_MINSTACK;
+  ci->callstatus = 0;
+  luaC_checkGC(L);
+  n = (*f)(L);  /* do the actual call */
+  first = L->top - n;
+  res = ci->func;  /* re-read: the stack may have moved */
+  L->ci = ci->previous;  /* back to caller */
+  for (i = nresults; i != 0 && first < L->top; i--)
+    setobjs2s(L, res++, first++);
+  while (i-- > 0)
+    setnilvalue(res++);
+  L->top = res;
+}
+
