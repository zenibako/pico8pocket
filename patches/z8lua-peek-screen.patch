--- a/lua.h
+++ b/lua.h
@@ -258,6 +258,8 @@
 LUA_API void  (lua_setuservalue) (lua_State *L, int idx);
 
 LUA_API void  (lua_setpico8memory) (lua_State *L, unsigned char const *p);
+LUA_API void  (lua_setpico8peekhook) (lua_State *L, unsigned char const *dirty,
+                                      void (*hook) (int address, int length));
 
