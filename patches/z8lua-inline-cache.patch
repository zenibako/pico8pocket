+/*
+** Pico8Pocket: inline caches.  An instruction whose key is a constant short
+** string remembers the index of the hash node where it last found the key.
+** A hit is one node check: same interned key, non-nil value.  This holds
+** whatever happened to the table since (a key occurs at most once in a
+** table) and whatever table it is now, so objects built alike share hits.
+** Anything else takes the full lookup, which refreshes the hint.
+*/
+#define ICACHE_EMPTY	0xffffu
+
+static unsigned short *icache_new (lua_State *L, Proto *p) {
+  int j;
+  unsigned short *ic = luaM_newvector(L, p->sizecode, unsigned short);
+  for (j = 0; j < p->sizecode; j++) ic[j] = ICACHE_EMPTY;
+  p->icache = ic;
+  return ic;
+}
+
+/* Out of BRAM: hits are inline, and misses are rare once hints settle. */
+static __attribute__((noinline))
+TValue *icache_miss (Table *h, TString *key, unsigned short *hint) {
+  Node *n = gnode(h, lmod(key->tsv.hash, sizenode(h)));  /* hashstr */
+  do {
+    if (ttisshrstring(gkey(n)) && eqshrstr(rawtsvalue(gkey(n)), key)) {
+      size_t idx = cast(size_t, n - gnode(h, 0));
+      if (ttisnil(gval(n))) return NULL;
+      if (idx < ICACHE_EMPTY) *hint = cast(unsigned short, idx);
+      return gval(n);
+    }
+    n = gnext(n);
+  } while (n);
+  return NULL;
+}
+
+static inline TValue *icache_get (Table *h, TString *key,
+                                  unsigned short *hint) {
+  unsigned idx = *hint;
+  if (idx < cast(unsigned, sizenode(h))) {
+    Node *n = gnode(h, idx);
+    if (ttisshrstring(gkey(n)) && rawtsvalue(gkey(n)) == key &&
+        !ttisnil(gval(n)))
+      return gval(n);
+  }
+  return icache_miss(h, key, hint);
+}
+
+/* fastslot() for an instruction's key operand (constant when 'isk'). */
+#define cachedslot(t,key,isk) \
+  ((isk) && ttistable(t) && ttisshrstring(key) \
+     ? icache_get(hvalue(t), rawtsvalue(key), ic + (pc - 1 - code)) \
+     : fastslot(t, key))
+
+/* fastset() through the cache. */
+#define cachedset(L,t,key,isk,val) \
+  fastsetslot(L, t, cachedslot(t, key, isk), val)
+
+static inline int fastsetslot (lua_State *L, const TValue *t,
+                               TValue *slot, const TValue *val) {
   if (slot == NULL) return 0;
   /* An existing non-nil entry means no __newindex can apply. */
   setobj2t(L, slot, val);
