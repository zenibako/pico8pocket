+/*
+** Pico8Pocket: inline lookups for the common case of a plain table indexed
+** by a short string or an integral number whose entry already exists.
+** Anything else (missing entries, metamethods, string indexing, the
+** sandbox fallback) still goes through luaV_gettable/luaV_settable.
+*/
+#if !defined(LUAI_VM_HOT)
+#define LUAI_VM_HOT inline
+#endif
+
+static LUAI_VM_HOT TValue *fastslot (const TValue *t, const TValue *key) {
+  const TValue *res;
+  if (!ttistable(t)) return NULL;
+  if (ttisshrstring(key))
+    res = luaH_getstr(hvalue(t), rawtsvalue(key));
+  else if (ttisnumber(key)) {
+    int k;
+    lua_Number n = nvalue(key);
+    lua_number2int(k, n);
+    if (!luai_numeq(cast_num(k), n)) return NULL;
+    res = luaH_getint(hvalue(t), k);
+  }
+  else return NULL;
+  return ttisnil(res) ? NULL : cast(TValue *, res);
+}
+
+
+static inline int fastset (lua_State *L, const TValue *t, const TValue *key,
+                           const TValue *val) {
+  TValue *slot = fastslot(t, key);
+  if (slot == NULL) return 0;
+  /* An existing non-nil entry means no __newindex can apply. */
+  setobj2t(L, slot, val);
+  invalidateTMcache(hvalue(t));
+  luaC_barrierback(L, obj2gco(hvalue(t)), val);
+  return 1;
+}
+
+
